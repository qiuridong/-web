# =========================================
# 前端环境变量示例
# =========================================
# 用法: cp .env.example .env.local
# .env.local 不入 git
# =========================================

# 后端 API 基地址
# - 本地开发:留空或 / ,走 vite proxy(配置见 vite.config.ts)
# - 直连开发:VITE_API_BASE=http://localhost:8000
# - 生产:留空(由 Caddy 反代,与前端同源)
VITE_API_BASE=

# 脚本货架(Script Hub)基地址 —— 「脚本市场」页拉货架列表 + 拼 bundle.zip 安装 URL
# - 默认(留空):https://hub.aijiaxia.cc(生产货架)
# - 本地联调:VITE_HUB_URL=http://localhost:8100(货架后端直连;需货架 CORS 放行管家 origin)
VITE_HUB_URL=
