# 脚本货架后端环境变量示例（复制为 .env 或由 install-hub.sh 生成）
ENVIRONMENT=production
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# SQLite 业务库（容器内绝对路径）
DATABASE_URL=sqlite:////app/data/hub.sqlite3

# 纯 HTTP / IP 部署（无 HTTPS）时取消注释，否则浏览器不回传 Secure cookie 登不进
# COOKIE_SECURE=false

# M3 对接：允许签到管家前端跨域直读货架列表（逗号分隔）
# CORS_ORIGINS=https://jb.aijiaxia.cc
